# ============================================================
# LexMask local/dev environment template
# Copy this file to .env and adjust values as needed.
# ============================================================

# ---------- Basics ----------
DEBUG=false
# APP_NAME=DataShield Redaction Infrastructure
# BACKEND_ENV_FILE=.env

# ---------- Authentication ----------
AUTH_ENABLED=true
# JWT_SECRET_KEY=
# JWT_EXPIRE_MINUTES=1440

# ---------- Directories ----------
# 仅 Docker 需要（compose 已内置同值）。本地 Windows 开发不要取消注释，
# 否则 /app/data 会被解析成盘根目录；不设置时后端使用项目内默认目录。
# DATA_DIR=/app/data
# UPLOAD_DIR=/app/uploads
# OUTPUT_DIR=/app/outputs

# ---------- File limits ----------
# 单文件上传上限（字节）。不设置或 0 = 不限制；需要限制时取消注释并按字节设定。
# MAX_FILE_SIZE=52428800
# docker 部署下 nginx 的 client_max_body_size 自动随上面这个值联动
# （自动加 8MB multipart 封装开销，0=不限）；如需单独指定可设
# NGINX_CLIENT_MAX_BODY_SIZE（nginx 尺寸语法，如 100M、0）。
# NGINX_CLIENT_MAX_BODY_SIZE=100M

# ---------- Service endpoints ----------
# Docker internal network — 仅 Docker 需要（compose 已内置同值），
# 本地开发保持注释（npm run dev 会自动指向 WSL 服务地址）:
# OCR_BASE_URL=http://ocr:8082
# HAS_TEXT_VLLM_BASE_URL=http://ner:8080/v1
# VISUAL_FEATURES_BASE_URL=http://visual-features:8090

# Host ports:
# OCR_PORT=8082
# NER_PORT=8080
# VISUAL_FEATURES_PORT=8090

# Local development without Docker:
# OCR_BASE_URL=http://127.0.0.1:8082
# HAS_TEXT_VLLM_BASE_URL=http://127.0.0.1:8080/v1
# VISUAL_FEATURES_BASE_URL=http://127.0.0.1:8090

# ---------- Local npm dev profile ----------
# npm run dev starts the frontend, backend, PaddleOCR-VL, PP-StructureV3,
# HaS Text, and LocateAnything. The visual feature service replaces the old
# separate visual-region/checklist services and is the only visual model entry.

# 本地开发必填（npm run dev 启动时 required，缺少会直接报 config 错误）。
# 三个值都是 WSL 内的 Linux 路径，参见 README "WSL 模型服务环境准备":
# WSL venv that runs PP-StructureV3 / the OCR wrapper (scripts/ocr_server.py):
VENV_DIR=/home/YOUR_USER/.cache/lexmask/.venv
# WSL venv with vLLM installed (serves HaS Text, optional PaddleOCR-VL / LocateAnything LM):
VLLM_VENV_DIR=/home/YOUR_USER/.cache/lexmask/.venv-vllm
# HaS Text HF (bf16) model directory, as a WSL path:
HAS_TEXT_HF_MODEL_PATH=/mnt/d/has_models/HaS_4.0_0.6B

# Windows project venv for the FastAPI backend (optional, default .venv):
# WINDOWS_VENV_DIR=.venv

# PaddleOCR-VL 1.6 via vLLM in WSL:
# OCR_VL_BACKEND=vllm-server
# OCR_VLLM_URL=http://127.0.0.1:8118/v1
# OCR_VL_API_MODEL_NAME=PaddleOCR-VL-1.6-0.9B
# --kv-cache-memory-bytes pins the KV size explicitly. Profiling-based sizing
# reads WSL/WDDM free-memory numbers that go wrong once several models are
# resident, which makes cold starts fail on whichever large engine loads last.
# VLLM_EXTRA_ARGS=--max-model-len 4096 --max-num-batched-tokens 1536 --gpu-memory-utilization 0.20 --kv-cache-memory-bytes 536870912 --no-enable-prefix-caching --mm-processor-cache-gb 0 --enforce-eager --attention-backend TRITON_ATTN --mm-encoder-attn-backend TORCH_SDPA

# HaS Text via vLLM in WSL (model path: see required HAS_TEXT_HF_MODEL_PATH above):
# HAS_TEXT_RUNTIME=vllm
# HAS_TEXT_MODEL_NAME=HaS_4.0_0.6B
# HAS_TEXT_VLLM_EXTRA_ARGS=--dtype bfloat16 --max-model-len 4096 --max-num-batched-tokens 4096 --gpu-memory-utilization 0.15 --no-enable-prefix-caching --enforce-eager --default-chat-template-kwargs {"enable_thinking":false}
# HAS_NER_CONTEXT_TOKENS=8192
# HAS_NER_MAX_TOKENS=8192
# NER 完成帽（Issue#41 / Issue#209）：默认 **4096**。原 2048 对密集页（真实
# 第四卷第 133 页 ≈200 个实体值）必然截断——单次生成 70–124s，再由「残差整页
# 重发 + 分段补查」把 300s 页墙烧穿（#209 实测 >420s 不收敛）。抬到 4096 后
# 同一页一次主查 59.8s 收敛。实发上限仍受 context_room（context - 提示词 -
# 160 - 64）约束，8k 上下文时约 3.6k。≤0 = 关闭。
# 上调前先核对模型卡 generation_config.json 的 max_new_tokens。
# HAS_NER_COMPLETION_HARD_CAP=4096

# —— Issue#209 成本结构旋钮（2026-10-29 门④实测定的默认值）——
# 页级 HaS NER 预算（秒）：从**页入口**起算，超时按 STRICT_FAIL 判定。
# 页 133 修后真实耗时 163s ⇒ 200s = 真实值 +25%，仍在 300s 页墙前留 ~100s
# 给 OCR/视觉/匹配。默认 200；≤0 = 关闸（退回无预算的旧行为）。
# HAS_NER_PAGE_BUDGET_SEC=200
# True = 超预算即判该页失败（页级隔离，进 recognition.failed_pages，不连坐整卷）；
# False = 用已聚合部分结果收尾（仍记 metrics/WARNING + has_text_partial_scan）。
# HAS_NER_PAGE_BUDGET_STRICT_FAIL=True
# 残差自证禁整页重发：残差 payload ≥ max(MIN_CHARS, 主查 payload × RATIO) 时跳过。
# 截断页的「未被解释墨迹」约等于整页，若不跳闸就会整页重问一遍（5372 字符 ×
# 20 类型 ⇒ 又一发截断）。双闸：绝对量大**且**相对也大才跳。RATIO=0 关闭本闸。
# HAS_NER_RESIDUAL_MAX_PAYLOAD_RATIO=0.35
# HAS_NER_RESIDUAL_MIN_CHARS=2000
# 补查沿文本轴切块（默认 0=始终切：整段 3924 字符 × 2 类型单请求实测 72.6s，
# 比 450 字符块慢一个数量级）。类型轴只在整批真装不下完成帽时才切。
# HAS_NER_REQUERY_SINGLE_PASS_MAX_CHARS=0
# HAS_NER_REQUERY_MAX_TYPES_PER_CALL=2
# 提示词侧近似重复折叠（默认 **关**）：族键「数字→#」无法区分水印碎片与
# 「标签+不同数字」的真实表单列，实测 120 行表单会被折到 5 行（静默少打码）。
# 保留为可选辅助能力，等有能区分两者形态的判据再默认开。
# HAS_NER_NEAR_DUP_COLLAPSE=0
# HAS_NER_NEAR_DUP_MIN_PAYLOAD_LINES=120
# HAS_NER_NEAR_DUP_FAMILY_MIN_MEMBERS=3
# HAS_NER_NEAR_DUP_MAX_LINE_CHARS=40
# HAS_NER_NEAR_DUP_MIN_CJK_CHARS=2
# 流式「归一化行复读」实时掐断（默认 **关**）：模型输出形如
# {"text": "*721720240174000394", "type": "编号"} 的 JSON 行（≈45 字符、含 CJK）
# 在真实报关单号列上天然同键重复 ⇒ 会在第 4 行掐断，把 83 个编号砍到 ~4 个。
# 仅当确认某类卷确实需要时开。
# HAS_STREAM_LINE_REPEAT_ABORT=0
# HAS_STREAM_LINE_REPEAT_MIN_OCCURRENCES=4
# HAS_STREAM_LINE_REPEAT_MAX_LINE_CHARS=48
# HAS_STREAM_LINE_REPEAT_MIN_CJK_CHARS=1
# 每类型完成 token 成本（Issue#41 S1 校准，默认 160）：预算公式与分批容量
# 共用。显式设置一律尊重（设回 72 ≈ 复现 preview 预算）；帽=0 只关闭分批、
# 不改预算。注意：legacy 旋钮（HAS_NER_SINGLE_PASS_MAX_TYPES 等）在帽>0 时
# 被帽接管取代。
# HAS_NER_TOKENS_PER_TYPE=160

# LocateAnything visual feature service in WSL:
# LOCATE_ANYTHING_ENABLED=1
# LOCATE_ANYTHING_MODEL=/mnt/d/has_models/LocateAnything-3B-HF
# LOCATE_ANYTHING_BACKEND=hf
# vLLM-backed Qwen2 text backbone for LocateAnything (prompt-embeds split):
# LOCATE_ANYTHING_VLLM_URL=http://localhost:8091/v1/completions
# LOCATE_ANYTHING_VLLM_MODEL=locate_qwen2_model
# LOCATE_ANYTHING_LM_MODEL_DIR=/mnt/d/has_models/locate_qwen2_model
# LOCATE_ANYTHING_LM_VLLM_EXTRA_ARGS=--dtype bfloat16 --max-model-len 8192 --max-num-seqs 4 --gpu-memory-utilization 0.43 --kv-cache-memory-bytes 805306368 --attention-backend TRITON_ATTN
# LOCATE_ANYTHING_DTYPE=bfloat16
# Issue#96 公章来源：la（默认，现役 LA 通道）/ mineru（改用 MinerU sidecar 的 seal 块）。
# 门④ AC2 判定：生产链下 mineru 章级召回 0.5652 < la 0.5942 ⇒ 默认保持 la。
# VISUAL_SEAL_SOURCE=la
# VISUAL_SEAL_MINERU_TIMEOUT=60.0
# VISUAL_SEAL_MINERU_FALLBACK_TO_LA=true
# LOCATE_ANYTHING_PORT=8090
# LOCATE_ANYTHING_MAX_IMAGE_SIDE=1280
# LOCATE_ANYTHING_SIGNATURE_MAX_IMAGE_SIDE=1280
# LOCATE_ANYTHING_SIGNATURE_TILE_MAX_IMAGE_SIDE=1280
# LOCATE_ANYTHING_MAX_NEW_TOKENS=8192
# LOCATE_ANYTHING_GENERATION_MODE=hybrid
# LOCATE_ANYTHING_FAST_FIRST=1
# LOCATE_ANYTHING_FAST_FIRST_FALLBACK_ON_EMPTY=1
# LOCATE_ANYTHING_SIGNATURE_TILE_FALLBACK_MAX_TILES=1
# VISUAL_FEATURES_SIGNATURE_OCR_FAST_PATH=true
# VISUAL_FEATURES_SIGNATURE_LOCAL_SUPPLEMENTS_ENABLED=true
# VISUAL_FEATURES_SIGNATURE_SKIP_WHEN_OCR_ANCHOR_FOUND=true
# OCR_MAX_IMAGE_SIDE=2048
# OCR_MAX_NEW_TOKENS=2048
# OCR_STRUCTURE_ENABLED=false
# OCR_STRUCTURE_WARMUP=0
# OCR_STRUCTURE_TEXT_PRECISION_ENABLED=false

# ---------- Timeouts ----------
# OCR_TIMEOUT=360
# HAS_TIMEOUT=120
# VISUAL_FEATURES_TIMEOUT=240

# ---------- PaddleOCR device ----------
# OCR_REQUIRE_GPU=false
# OCR_STRUCTURE_TEXT_PRECISION_ENABLED=true
# Enable GPU services with:
# docker compose --profile gpu up -d

# ---------- Concurrency ----------
# JOB_CONCURRENCY=3
# BATCH_RECOGNITION_PAGE_CONCURRENCY=1
# HAS_NER_MAX_PARALLEL_REQUESTS=8    # Issue#103：默认 8，见 docker-compose.yml
# HAS_NER_GLOBAL_MAX_INFLIGHT=8      # Issue#103：唯一真正绑定并发的闸门；单卡小显存可回退 1
# HAS_NER_VERIFY_PARALLEL_CAP=8      # Issue#103：residual verify 页内窗口；单卡小显存可回退 1
# VISUAL_FEATURES_CONCURRENCY=1
# VISION_DUAL_PIPELINE_PARALLEL=false

# ---------- CORS ----------
# CORS_ORIGINS=["http://localhost:3000"]
# WARNING: do not use ["*"] in production.

# ---------- Optional security ----------
# VIRUS_SCAN_ENABLED=false

# ---------- Reverse proxy ----------
# Trusted proxy IPs / CIDRs (JSON list). X-Forwarded-For is only honoured when
# request.client.host matches one of these. Default: loopback (127.0.0.1/::1)
# + 172.16.0.0/12 (covers the docker compose bridge network). If your reverse
# proxy sits on a 10.x or 192.168.x network, configure it explicitly:
# TRUSTED_PROXIES=["127.0.0.1","::1","192.168.1.10"]

# ---------- Redaction ----------
# DEFAULT_REPLACEMENT_MODE=smart

# ---------------------------------------------------------------- 内嵌文本层文档级链（Issue#115）
# 扫描件自带内嵌 OCR 文本层时，改用「整卷一次分块 HaS」替代逐页 OCR+页内多轮 HaS。
# **Issue#129 起默认开**（验收见 LexMask-workspace/docs/acceptance/
# 2026-10-15-issue115-文档级链验收方案.md）；置 false 可整链回退到 #115 之前的逐页视觉线。
# 开启代价：任一页首次请求须等整卷分块建流（60 页约 115s、189 页约 231s），之后各页 memo 命中秒级。
TEXT_LAYER_DOCLINE_ENABLED=true
# 逐页准入：一页文本层字符数低于它就这一页回落旧路径（混合卷靠它保覆盖率）。
TEXT_LAYER_PAGE_MIN_CHARS=60
# 整块并发度（同时受 HAS_NER_GLOBAL_MAX_INFLIGHT 全局闸门约束）。
TEXT_LAYER_DOCLINE_CONCURRENCY=4
# 卷级合格门：任一不满足即整卷回落旧路径，宁可慢不可错。
TEXT_LAYER_MIN_COVERAGE=0.90
# 建流预算闸（Issue#129 评审 I1）：整卷建流在首个请求里同步跑完，预计耗时超预算即
# 本卷不接管、逐页回落旧线——否则首发请求会超过网关 proxy_read_timeout 被打 504。
TEXT_LAYER_DOCLINE_MAX_BUILD_SEC=600
TEXT_LAYER_DOCLINE_BUILD_SEC_PER_PAGE=1.6
TEXT_LAYER_MAX_MAP_FAILURE_RATIO=0.30
# 单「词」最大字数（粘连层判据）：真实卷 60 页样本最长 48 字、p99=34；
# 整页被拼成一个 word 的坏层会到 2000+。钳 [40, 100000]。
TEXT_LAYER_MAX_WORD_CHARS=400
# 预建链闸：跨页高频重复**长词**覆盖占比（Issue#203，默认值经 AC0 实测冻结)。
# 事故形态 = 每页内嵌文本层被防泄漏水印的打散碎片词支配（同一高熵长 token 逐页重复
# 上千次、真实正文极薄，实测 coverage 0.3827），文档级链会整卷建链撞单页页超时门限 →
# 整卷作废；干净真实层卷实测 0.0。覆盖率 **>** 阈值即在 run_document_ner 之前拒绝并落
# permanent 负缓存，整卷回落逐页线（更慢，但召回不降）。
# 判据口径：字符数 ≥ TEXT_LAYER_REPEATED_TOKEN_MIN_CHARS 的词出现
# ≥ TEXT_LAYER_REPEATED_FRAGMENT_MIN_REPEATS 次 **且** 跨越
# ≥ TEXT_LAYER_REPEATED_FRAGMENT_MIN_PAGES 个不同页（两个条件共同决定分子）。
# 阈值偏「宁可错拒」：错拒代价=回落逐页线，漏拒代价=整卷成果清零。
# TEXT_LAYER_MAX_REPEATED_FRAGMENT_COVERAGE=0 表示**关闸**（不推荐——#203 事故形态回到无防护）；
# 钳 [0.0, 1.0]，1.0 等于永不触发。
TEXT_LAYER_REPEATED_TOKEN_MIN_CHARS=10
TEXT_LAYER_REPEATED_FRAGMENT_MIN_REPEATS=8
TEXT_LAYER_REPEATED_FRAGMENT_MIN_PAGES=5
TEXT_LAYER_MAX_REPEATED_FRAGMENT_COVERAGE=0.15
# 已知边界（#203 留痕）：只认 ≥10 字的整词，水印碎片若为 5~9 字则本闸完全不可见；
# 放大 token 长度上限或改判据前须先按 AC0 同款测量复核新形态卷。
